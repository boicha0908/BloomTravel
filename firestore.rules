rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      // A trip can be read only by an authenticated member.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // The first signed-in user becomes the owner/member of a new trip.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid
        && request.auth.uid in request.resource.data.memberIds;

      // Existing members can edit shared trip data, but cannot remove themselves
      // from the membership list or change the owner.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.auth.uid in request.resource.data.memberIds;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }
  }
}
