rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /trips/{tripId} {
      // Existing members can open the trip. A signed-in invitee can also
      // open it once, so the invite acceptance flow can add their UID.
      allow get: if signedIn()
        && (request.auth.uid in resource.data.memberIds
            || request.auth.token.email in resource.data.pendingInvites);

      // Queries are limited to trips the signed-in user already belongs to.
      allow list: if signedIn()
        && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerUid
        && request.auth.uid in request.resource.data.memberIds;

      // Members can edit shared trip data. An invited email can update once
      // to add their own UID, but cannot change the owner.
      allow update: if signedIn()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (request.auth.uid in resource.data.memberIds
            || request.auth.token.email in resource.data.pendingInvites)
        && request.auth.uid in request.resource.data.memberIds;

      allow delete: if signedIn()
        && request.auth.uid == resource.data.ownerUid;
    }

    match /tripInvites/{inviteId} {
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerUid;

      allow get, list: if signedIn()
        && (request.auth.uid == resource.data.ownerUid
            || request.auth.token.email == resource.data.email);

      allow update: if signedIn()
        && (request.auth.uid == resource.data.ownerUid
            || request.auth.token.email == resource.data.email);

      allow delete: if signedIn()
        && request.auth.uid == resource.data.ownerUid;
    }
  }
}
